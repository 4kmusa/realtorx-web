# RealtorX frontend environment (copy to .env.local; never commit real values).

# Local development: where the Vite dev proxy forwards /api/erp, /files and /private.
# Defaults to http://127.0.0.1:8000 (bench serve).
ERPNEXT_PROXY_TARGET="http://127.0.0.1:8000"

# Production (Vercel): base URL of the public Frappe site, no trailing slash. middleware.ts rewrites /api/erp/*,
# /files/* and /private/files/* there. Required: without it every data call returns "Server configuration missing".
ERPNEXT_URL="https://erp.example.com"

# Optional: link to ERPNext Desk for RealtorX staff on the sign-in page (default /app, which only works when the
# website and Desk share a host).
VITE_ERP_DESK_URL=""
# Dashboards only: the public website's address, for links back to it (default: the same origin).
VITE_WEBSITE_URL=""

# NOTE: ERPNEXT_API_KEY / ERPNEXT_API_SECRET are no longer used. The proxies forward only the
# visitor's own session cookie. Remove them from every environment and revoke the old key.
