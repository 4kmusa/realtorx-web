{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.0.0"
    }
  },
  "rewrites": [
    { "source": "/api/erp/:path*", "destination": "/api/erp/[...path]" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}

