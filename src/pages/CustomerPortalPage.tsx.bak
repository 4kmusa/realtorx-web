                <button
                  onClick={() => onNavigate('contact')}
                  className="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-950 bg-[#F5A623] hover:brightness-110 transition-all"
                >
                  Schedule New Visit
                </button>
              </div>

              <div className="space-y-3">
                {siteVisits.map(vst => (
                  <div key={vst.id} className="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div className="space-y-1">
                      <div className="flex items-center gap-2">
                        <span className="text-xs px-2.5 py-0.5 rounded-full bg-sky-950/60 text-sky-400 border border-sky-800/50">
                          {vst.status}
                        </span>
                        <span className="text-xs text-slate-400 font-mono">{vst.precinct}</span>
                      </div>
                      <h4 className="text-base font-bold text-white">{vst.propertyTitle}</h4>
                      <p className="text-xs text-slate-400">
                        Escorting Realtor: <strong className="text-white">{vst.agentName}</strong> ({vst.agentPhone})
                      </p>
                    </div>

                    <div className="flex items-center gap-4 text-xs font-mono">
                      <div className="text-right">
                        <div className="text-white font-bold flex items-center gap-1">
                          <Calendar className="w-3.5 h-3.5 text-[#F5A623]" />
                          <span>{vst.date}</span>
                        </div>
                        <div className="text-slate-400 flex items-center gap-1 mt-0.5">
                          <Clock className="w-3.5 h-3.5 text-slate-500" />
                          <span>{vst.timeSlot}</span>
                        </div>
                      </div>
                      <a
                        href={`https://wa.me/923002341908?text=Hello%20${vst.agentName},%20regarding%20my%20scheduled%20visit`}
                        target="_blank"
                        rel="noreferrer"
                        className="px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-sans text-xs transition-colors"
                      >
                        WhatsApp Agent
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* TAB 7: Profile */}
          {activeTab === 'profile' && (
            <div className="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6">
              <h2 className="text-xl font-bold text-white font-heading">
                Allottee Profile &amp; Legal Nominee
              </h2>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm">
                <div className="space-y-1">
                  <span className="text-slate-400 block text-xs">Full Legal Name:</span>
                  <div className="text-white font-semibold">{customer.name}</div>
                </div>
                <div className="space-y-1">
                  <span className="text-slate-400 block text-xs">CNIC Number:</span>
                  <div className="text-white font-mono">{customer.cnic}</div>
                </div>
                <div className="space-y-1">
                  <span className="text-slate-400 block text-xs">Email Address:</span>
                  <div className="text-white">{customer.email}</div>
                </div>
                <div className="space-y-1">
                  <span className="text-slate-400 block text-xs">Mobile Phone:</span>
                  <div className="text-white font-mono">{customer.phone}</div>
                </div>
                <div className="md:col-span-2 space-y-1">
                  <span className="text-slate-400 block text-xs">Postal / Delivery Address:</span>
                  <div className="text-white">{customer.address}</div>
                </div>

                <div className="md:col-span-2 pt-4 border-t border-slate-800">
                  <h3 className="text-sm font-bold text-[#F5A623] mb-3">Nominee Details (Bahria Transfer Record)</h3>
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <span className="text-slate-500 block text-xs">Nominee Name:</span>
                      <div className="text-white font-medium">{customer.nomineeName}</div>
                    </div>
                    <div>
                      <span className="text-slate-500 block text-xs">Nominee CNIC:</span>
                      <div className="text-white font-mono">{customer.nomineeCnic}</div>
                    </div>
                    <div>
                      <span className="text-slate-500 block text-xs">Relationship:</span>
                      <div className="text-white">{customer.nomineeRelation}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

        </div>
      )}

    </div>
  );
};
