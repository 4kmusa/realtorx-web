import React, { useState } from 'react';
import { PageId, Language, CustomerUser, CustomerBooking, CustomerDeal, PaymentScheduleItem, PaymentHistoryItem, CustomerDocument, SiteVisitRecord } from '../types';
import { RealtorXLogo } from '../components/RealtorXLogo';
import {
  User,
  Shield,
  KeyRound,
  Mail,
  Phone,
  CheckCircle2,
  Calendar,
  Clock,
  FileText,
  CreditCard,
  Building,
  MapPin,
  Download,
  Eye,
  LogOut,
  ChevronRight,
  Sparkles,
  ArrowRight,
  AlertCircle,
  FileCheck
} from 'lucide-react';

interface CustomerPortalPageProps {
  onNavigate: (page: PageId, extraId?: string) => void;
  language: Language;
}

export const CustomerPortalPage: React.FC<CustomerPortalPageProps> = ({ onNavigate, language }) => {
  // Auth state (Email + OTP)
  const [isAuthenticated, setIsAuthenticated] = useState<boolean>(() => {
    return localStorage.getItem('realtorx_customer_logged_in') === 'true';
  });

  const [authStep, setAuthStep] = useState<'email' | 'otp'>('email');
  const [emailInput, setEmailInput] = useState('kamran.akhtar@gmail.com');
  const [otpInput, setOtpInput] = useState('');
  const [otpSentNotice, setOtpSentNotice] = useState(false);
  const [activeTab, setActiveTab] = useState<'bookings' | 'deals' | 'schedule' | 'history' | 'documents' | 'visits' | 'profile'>('bookings');

  // Customer profile info
  const [customer, setCustomer] = useState<CustomerUser>({
    id: 'rx-cust-8821',
    name: 'Kamran Akhtar',
    email: 'kamran.akhtar@gmail.com',
    phone: '+92 321 4458921',
    cnic: '42101-7894561-3',
    address: 'House 14-B, Street 9, Precinct 10-A, Bahria Town Karachi',
    nomineeName: 'Samina Kamran',
    nomineeCnic: '42101-9988771-2',
    nomineeRelation: 'Spouse'
  });

  // Mock initial data
  const [bookings] = useState<CustomerBooking[]>([
    {
      id: 'bk-101',
      bookingRef: 'BTK-BKG-9921',
      propertyTitle: '200 Sq. Yards Luxury Villa',
      precinct: 'Precinct 10-A (Villas)',
      type: 'Luxury Villa',
      totalPricePkr: 24500000,
      tokenPaidPkr: 2000000,
      bookingDate: '2026-02-14',
      status: 'Confirmed'
    },
    {
      id: 'bk-102',
      bookingRef: 'BTK-BKG-8402',
      propertyTitle: '125 Sq. Yards Residential Plot',
      precinct: 'Precinct 15-B',
      type: 'Residential Plot',
      totalPricePkr: 7200000,
      tokenPaidPkr: 1000000,
      bookingDate: '2026-01-20',
      status: 'Transferred'
    }
  ]);

  const [deals] = useState<CustomerDeal[]>([
    {
      id: 'dl-201',
      dealNumber: 'RX-DEAL-7809',
      propertyTitle: '200 Sq. Yards Luxury Villa - Precinct 10-A',
      category: 'Luxury Villa',
      closingAgent: 'Zubair Farooqi (Certified Dealer)',
      agentPhone: '+92 300 2341908',
      totalAmountPkr: 24500000,
      status: 'In Transfer',
      handoverDate: '2026-06-30'
    },
    {
      id: 'dl-202',
      dealNumber: 'RX-DEAL-6512',
      propertyTitle: '125 Sq. Yards Plot - Precinct 15-B',
      category: 'Residential Plot',
      closingAgent: 'Malik Asad &amp; Associates',
      agentPhone: '+92 333 4901233',
      totalAmountPkr: 7200000,
      status: 'Completed',
      handoverDate: '2026-02-05'
    }
  ]);

  const [paymentSchedule] = useState<PaymentScheduleItem[]>([
    { id: 'sch-1', milestone: 'Down Payment (20%)', dueDate: '2026-02-14', amountPkr: 4900000, status: 'Paid', receiptNo: 'RCP-8801' },
    { id: 'sch-2', milestone: '1st Quarterly Installment', dueDate: '2026-05-14', amountPkr: 2450000, status: 'Upcoming' },
    { id: 'sch-3', milestone: '2nd Quarterly Installment', dueDate: '2026-08-14', amountPkr: 2450000, status: 'Upcoming' },
    { id: 'sch-4', milestone: '3rd Quarterly Installment', dueDate: '2026-11-14', amountPkr: 2450000, status: 'Upcoming' },
    { id: 'sch-5', milestone: 'Possession & Utility Charges', dueDate: '2027-02-14', amountPkr: 2000000, status: 'Upcoming' },
  ]);

  const [paymentHistory] = useState<PaymentHistoryItem[]>([
    { id: 'pay-1', receiptNo: 'RCP-8801', transactionRef: 'FT26045812903', date: '2026-02-14', amountPkr: 4900000, paymentMethod: 'Pay Order', purpose: 'Down Payment - Precinct 10A Villa', status: 'Cleared' },
    { id: 'pay-2', receiptNo: 'RCP-7612', transactionRef: '1LINK-9923881', date: '2026-01-20', amountPkr: 1000000, paymentMethod: 'Online Banking (1Link)', purpose: 'Booking Token - Precinct 15B', status: 'Cleared' },
  ]);

  const [documents] = useState<CustomerDocument[]>([
    { id: 'doc-1', title: 'Allotment Letter - Precinct 10-A Villa 44', docType: 'Allotment Letter', dateIssued: '2026-02-15', fileSize: '2.4 MB', verified: true },
    { id: 'doc-2', title: 'Official Bahria Town Transfer Receipt', docType: 'Transfer Receipt', dateIssued: '2026-02-14', fileSize: '1.1 MB', verified: true },
    { id: 'doc-3', title: 'Town Planning & Utilities NOC Clearance', docType: 'NOC Clearance', dateIssued: '2026-02-10', fileSize: '850 KB', verified: true },
    { id: 'doc-4', title: 'Architectural Layout & Site Plan', docType: 'Site Plan', dateIssued: '2026-02-01', fileSize: '4.8 MB', verified: true },
  ]);

  const [siteVisits] = useState<SiteVisitRecord[]>([
    { id: 'vst-1', propertyTitle: '200 Sq. Yards Villa #44', precinct: 'Precinct 10-A', date: '2026-03-02', timeSlot: '11:00 AM - 01:00 PM', agentName: 'Zubair Farooqi', agentPhone: '+92 300 2341908', status: 'Scheduled' },
    { id: 'vst-2', propertyTitle: '125 Sq. Yards Corner Plot', precinct: 'Precinct 15-B', date: '2026-01-18', timeSlot: '03:00 PM - 05:00 PM', agentName: 'Malik Asad', agentPhone: '+92 333 4901233', status: 'Completed' },
  ]);

  const handleSendOtp = (e: React.FormEvent) => {
    e.preventDefault();
    if (!emailInput.trim()) return;
    setOtpSentNotice(true);
    setAuthStep('otp');
    setOtpInput('789012'); // Demo prefill for instantaneous convenience
  };

  const handleVerifyOtp = (e: React.FormEvent) => {
    e.preventDefault();
    setIsAuthenticated(true);
    localStorage.setItem('realtorx_customer_logged_in', 'true');
  };

  const handleLogout = () => {
    setIsAuthenticated(false);
    localStorage.removeItem('realtorx_customer_logged_in');
    setAuthStep('email');
  };

  return (
    <div className="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 text-slate-100">
      
      {/* Not Logged In: Email + OTP Login / Signup */}
      {!isAuthenticated ? (
        <div className="max-w-md mx-auto py-12">
          <div className="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 shadow-2xl space-y-6">
            
            <div className="text-center space-y-2">
              <div className="flex justify-center mb-2">
                <RealtorXLogo size="sm" showSubtitle={false} />
              </div>
              <h1 className="text-2xl font-bold text-white font-heading">
                Customer Portal Login
              </h1>
              <p className="text-xs text-slate-400">
                Access your Bahria Town property bookings, payment schedules, and verified title deeds.
              </p>
            </div>

            {authStep === 'email' ? (
              <form onSubmit={handleSendOtp} className="space-y-4">
                <div className="space-y-1.5">
                  <label className="text-xs font-medium text-slate-300 flex items-center gap-1.5">
                    <Mail className="w-3.5 h-3.5 text-[#2490EF]" />
                    <span>Registered Email Address</span>
                  </label>
                  <input
                    type="email"
                    required
                    placeholder="name@domain.com"
                    value={emailInput}
                    onChange={(e) => setEmailInput(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#2490EF] transition-colors"
                  />
                </div>

                <button
                  type="submit"
                  className="w-full py-3.5 rounded-xl text-sm font-semibold text-slate-950 bg-gradient-to-r from-[#2490EF] via-[#52a7f5] to-[#2490EF] hover:brightness-110 shadow-lg transition-all flex items-center justify-center gap-2"
                >
                  <KeyRound className="w-4 h-4 text-slate-950" />
                  <span>Send One-Time Password (OTP)</span>
                </button>

                <div className="p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-[11px] text-slate-400 text-center">
                  Protected by ERPNext Customer OAuth &amp; 2FA
                </div>
              </form>
            ) : (
              <form onSubmit={handleVerifyOtp} className="space-y-4">
                <div className="p-3 rounded-xl bg-emerald-950/30 border border-emerald-800/40 text-xs text-emerald-300 flex items-center gap-2">
                  <CheckCircle2 className="w-4 h-4 shrink-0" />
                  <span>OTP code sent to <strong>{emailInput}</strong></span>
                </div>

                <div className="space-y-1.5">
                  <label className="text-xs font-medium text-slate-300 flex items-center gap-1.5">
                    <KeyRound className="w-3.5 h-3.5 text-[#F5A623]" />
                    <span>Enter 6-Digit OTP</span>
                  </label>
                  <input
                    type="text"
                    required
                    maxLength={6}
                    placeholder="e.g. 789012"
                    value={otpInput}
                    onChange={(e) => setOtpInput(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-lg font-mono text-center tracking-widest text-[#F5A623] focus:outline-none focus:border-[#F5A623] transition-colors"
                  />
                </div>

                <button
                  type="submit"
                  className="w-full py-3.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-[#F5A623] to-[#FFA500] hover:brightness-110 shadow-lg transition-all flex items-center justify-center gap-2"
                >
                  <span>Verify &amp; Enter Customer Portal</span>
                  <ArrowRight className="w-4 h-4 text-slate-950" />
                </button>

                <button
                  type="button"
                  onClick={() => setAuthStep('email')}
                  className="w-full text-xs text-slate-400 hover:text-white transition-colors"
                >
                  Change Email Address
                </button>
              </form>
            )}

          </div>
        </div>
      ) : (
        /* Authenticated Dashboard */
        <div className="space-y-8">
          
          {/* Header Banner */}
          <div className="p-6 sm:p-8 rounded-3xl bg-slate-900/90 border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl">
            <div className="flex items-center gap-4">
              <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#2490EF] to-[#0A1628] border border-[#2490EF]/40 flex items-center justify-center text-white text-xl font-bold font-heading">
                {customer.name.charAt(0)}
              </div>
              <div>
                <div className="flex items-center gap-2">
                  <h1 className="text-xl sm:text-2xl font-bold text-white font-heading">
                    {customer.name}
                  </h1>
                  <span className="text-[10px] font-mono uppercase bg-emerald-950/60 text-emerald-400 border border-emerald-800/60 px-2 py-0.5 rounded-full">
                    Verified Buyer
                  </span>
                </div>
                <div className="text-xs text-slate-400 flex flex-wrap items-center gap-3 mt-1 font-mono">
                  <span>CNIC: {customer.cnic}</span>
                  <span>•</span>
                  <span>{customer.phone}</span>
                </div>
              </div>
            </div>

            <div className="flex items-center gap-3 self-stretch md:self-auto">
              <button
                onClick={() => onNavigate('properties')}
                className="flex-1 md:flex-initial px-4 py-2 text-xs font-semibold text-slate-950 bg-[#F5A623] hover:brightness-110 rounded-xl transition-all flex items-center justify-center gap-1.5"
              >
                <span>Browse Bahria Inventory</span>
              </button>
              <button
                onClick={handleLogout}
                className="px-3.5 py-2 text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-xl transition-colors flex items-center gap-1.5"
                title="Log Out"
              >
                <LogOut className="w-3.5 h-3.5" />
                <span>Logout</span>
              </button>
            </div>
          </div>

          {/* Navigation Tabs */}
          <div className="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-800 scrollbar-none">
            {[
              { id: 'bookings', label: 'My Bookings', icon: Building, count: bookings.length },
              { id: 'deals', label: 'My Deals', icon: Shield, count: deals.length },
              { id: 'schedule', label: 'Payment Schedule', icon: Calendar },
              { id: 'history', label: 'Payment History', icon: CreditCard, count: paymentHistory.length },
              { id: 'documents', label: 'Documents & Title', icon: FileCheck, count: documents.length },
              { id: 'visits', label: 'Site Visits', icon: MapPin, count: siteVisits.length },
              { id: 'profile', label: 'My Profile', icon: User },
            ].map(tab => {
              const Icon = tab.icon;
              const isActive = activeTab === tab.id;
              return (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id as any)}
                  className={`px-4 py-2.5 rounded-xl text-xs font-medium whitespace-nowrap transition-all flex items-center gap-2 ${
                    isActive
                      ? 'bg-[#2490EF] text-white shadow-md shadow-[#2490EF]/20'
                      : 'text-slate-400 hover:text-slate-200 hover:bg-slate-900'
                  }`}
                >
                  <Icon className="w-3.5 h-3.5" />
                  <span>{tab.label}</span>
                  {tab.count !== undefined && (
                    <span className={`text-[10px] px-1.5 py-0.2 rounded-full ${
                      isActive ? 'bg-white/20 text-white' : 'bg-slate-800 text-slate-400'
                    }`}>
                      {tab.count}
                    </span>
                  )}
                </button>
              );
            })}
          </div>

          {/* TAB 1: My Bookings */}
          {activeTab === 'bookings' && (
            <div className="space-y-4">
              <h2 className="text-lg font-bold text-white font-heading">
                Active Bahria Town Property Bookings
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {bookings.map(b => (
                  <div key={b.id} className="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-4">
                    <div className="flex items-center justify-between">
                      <span className="font-mono text-xs text-[#F5A623]">{b.bookingRef}</span>
                      <span className="text-xs px-2.5 py-1 rounded-full bg-emerald-950/60 text-emerald-400 border border-emerald-800/50">
                        {b.status}
                      </span>
                    </div>
                    <div>
                      <h3 className="text-lg font-bold text-white">{b.propertyTitle}</h3>
                      <p className="text-xs text-slate-400 mt-0.5">{b.precinct}</p>
                    </div>
                    <div className="grid grid-cols-2 gap-3 pt-2 border-t border-slate-800 text-xs">
                      <div>
                        <span className="text-slate-500 block">Total Price:</span>
                        <span className="text-white font-mono font-bold">PKR {(b.totalPricePkr / 10000000).toFixed(2)} Cr</span>
                      </div>
                      <div>
                        <span className="text-slate-500 block">Token Paid:</span>
                        <span className="text-emerald-400 font-mono font-bold">PKR {(b.tokenPaidPkr / 100000).toFixed(1)} Lac</span>
                      </div>
                    </div>
                    <div className="flex items-center justify-between pt-2 text-xs text-slate-400 font-mono">
                      <span>Booked: {b.bookingDate}</span>
                      <button
                        onClick={() => onNavigate('property-detail', 'rx-prop-001')}
                        className="text-[#2490EF] hover:underline flex items-center gap-1"
                      >
                        <span>View Details</span>
                        <ChevronRight className="w-3.5 h-3.5" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* TAB 2: My Deals */}
          {activeTab === 'deals' && (
            <div className="space-y-4">
              <h2 className="text-lg font-bold text-white font-heading">
                Contracted Real Estate Deals
              </h2>
              <div className="space-y-3">
                {deals.map(d => (
                  <div key={d.id} className="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div className="space-y-1">
                      <div className="flex items-center gap-2">
                        <span className="font-mono text-xs text-[#2490EF] font-bold">{d.dealNumber}</span>
                        <span className="text-xs px-2 py-0.5 rounded bg-sky-950/60 text-sky-400 border border-sky-800/50">
                          {d.status}
                        </span>
                      </div>
                      <h3 className="text-base font-bold text-white">{d.propertyTitle}</h3>
                      <p className="text-xs text-slate-400">
                        Assigned Agent: <strong className="text-slate-200">{d.closingAgent}</strong> ({d.agentPhone})
                      </p>
                    </div>

                    <div className="flex items-center gap-6">
                      <div className="text-right">
                        <span className="text-xs text-slate-400 block">Deal Volume</span>
                        <span className="text-base font-mono font-bold text-[#F5A623]">
                          PKR {(d.totalAmountPkr / 10000000).toFixed(2)} Crore
                        </span>
                      </div>
                      <div className="text-right text-xs text-slate-400 font-mono">
                        <span>Expected Handover:</span>
                        <div className="text-white font-semibold">{d.handoverDate}</div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* TAB 3: Payment Schedule */}
          {activeTab === 'schedule' && (
            <div className="space-y-4">
              <div className="flex items-center justify-between">
                <div>
                  <h2 className="text-lg font-bold text-white font-heading">
                    Official Payment Milestone Schedule
                  </h2>
                  <p className="text-xs text-slate-400">
                    Linked to Precinct 10-A Villa allotment contract.
                  </p>
                </div>
              </div>

              <div className="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/80">
                <table className="w-full text-left text-xs">
                  <thead className="bg-slate-950 text-slate-400 uppercase font-mono border-b border-slate-800">
                    <tr>
                      <th className="p-4">Milestone</th>
                      <th className="p-4">Due Date</th>
                      <th className="p-4">Amount (PKR)</th>
                      <th className="p-4">Status</th>
                      <th className="p-4">Receipt</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60 font-sans">
                    {paymentSchedule.map(p => (
                      <tr key={p.id} className="hover:bg-slate-850/50">
                        <td className="p-4 font-medium text-white">{p.milestone}</td>
                        <td className="p-4 font-mono text-slate-300">{p.dueDate}</td>
                        <td className="p-4 font-mono font-bold text-white">
                          PKR {p.amountPkr.toLocaleString()}
                        </td>
                        <td className="p-4">
                          <span className={`px-2.5 py-0.5 rounded-full text-[11px] font-medium ${
                            p.status === 'Paid'
                              ? 'bg-emerald-950/60 text-emerald-400 border border-emerald-800/50'
                              : 'bg-amber-950/60 text-amber-400 border border-amber-800/50'
                          }`}>
                            {p.status}
                          </span>
                        </td>
                        <td className="p-4 font-mono text-slate-400">
                          {p.receiptNo ? (
                            <span className="text-[#2490EF] hover:underline cursor-pointer">
                              {p.receiptNo}
                            </span>
                          ) : '—'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* TAB 4: Payment History */}
          {activeTab === 'history' && (
            <div className="space-y-4">
              <h2 className="text-lg font-bold text-white font-heading">
                Payment History &amp; Bank Receipts
              </h2>
              <div className="space-y-3">
                {paymentHistory.map(pay => (
                  <div key={pay.id} className="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div className="space-y-1">
                      <div className="flex items-center gap-2">
                        <span className="font-mono text-xs text-[#28A745] font-bold">{pay.receiptNo}</span>
                        <span className="text-slate-500 text-xs">•</span>
                        <span className="font-mono text-xs text-slate-400">{pay.date}</span>
                      </div>
                      <h4 className="text-sm font-semibold text-white">{pay.purpose}</h4>
                      <p className="text-xs text-slate-400 font-mono">
                        Method: {pay.paymentMethod} | Ref: {pay.transactionRef}
                      </p>
                    </div>

                    <div className="flex items-center gap-4">
                      <div className="text-right">
                        <span className="text-xs text-slate-500 block font-mono">Amount</span>
                        <span className="text-base font-mono font-bold text-emerald-400">
                          PKR {pay.amountPkr.toLocaleString()}
                        </span>
                      </div>
                      <button
                        onClick={() => window.print()}
                        className="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"
                        title="Print / Download Receipt"
                      >
                        <Download className="w-4 h-4" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* TAB 5: Documents */}
          {activeTab === 'documents' && (
            <div className="space-y-4">
              <h2 className="text-lg font-bold text-white font-heading">
                Verified Land Deeds &amp; Property Documentation
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {documents.map(doc => (
                  <div key={doc.id} className="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-start justify-between gap-4">
                    <div className="flex items-start gap-3">
                      <div className="p-3 rounded-xl bg-slate-800 text-[#2490EF]">
                        <FileText className="w-5 h-5" />
                      </div>
                      <div>
                        <h4 className="text-sm font-bold text-white">{doc.title}</h4>
                        <div className="flex items-center gap-2 text-xs text-slate-400 mt-1 font-mono">
                          <span>{doc.docType}</span>
                          <span>•</span>
                          <span>{doc.fileSize}</span>
                        </div>
                        <div className="text-[11px] text-emerald-400 flex items-center gap-1 mt-1">
                          <CheckCircle2 className="w-3 h-3" />
