import React, { useState, useEffect } from 'react';
import { PageId, Language, DealerUser, DealerLead, DealerDeal, CommissionLedgerEntry, SiteVisitRecord } from '../types';
import { RealtorXLogo } from '../components/RealtorXLogo';
import {
  ShieldCheck,
  Percent,
  TrendingUp,
  Users,
  Briefcase,
  DollarSign,
  Calendar,
  CheckSquare,
  User,
  LogOut,
  ArrowRight,
  MessageCircle,
  Plus,
  Building2,
  Award,
  AlertTriangle,
  Lock,
  Download,
  CreditCard,
  Clock,
  Sparkles,
  ChevronRight,
  CheckCircle2
} from 'lucide-react';

interface DealerPortalPageProps {
  onNavigate: (page: PageId, extraId?: string) => void;
  language: Language;
}

export const DealerPortalPage: React.FC<DealerPortalPageProps> = ({ onNavigate, language }) => {
  // Check if dealer oath is accepted
  const [hasAcceptedOath, setHasAcceptedOath] = useState<boolean>(() => {
    return localStorage.getItem('realtorx_dealer_oath_accepted') === 'true';
  });

  const [isLoggedIn, setIsLoggedIn] = useState<boolean>(() => {
    return localStorage.getItem('realtorx_dealer_logged_in') === 'true';
  });

  const [emailInput, setEmailInput] = useState('tariq.realtor@bahriatown.com');
  const [passwordInput, setPasswordInput] = useState('••••••••••');
  const [activeTab, setActiveTab] = useState<'target' | 'leads' | 'deals' | 'ledger' | 'payouts' | 'visits' | 'tasks' | 'profile'>('target');

  // Dealer Profile
  const [dealer, setDealer] = useState<DealerUser>({
    id: 'rx-dlr-042',
    name: 'Tariq Mahmood',
    email: 'tariq.realtor@bahriatown.com',
    phone: '+92 300 8472910',
    cnic: '42101-2948190-1',
    agencyName: 'Mahmood Estate &amp; Builders',
    bahriaRegNo: 'BTK-REG-2041-A',
    bankName: 'Meezan Bank Limited',
    iban: 'PK44MEZN0001092849102901',
    oathAccepted: hasAcceptedOath,
    oathAcceptedDate: '2026-01-15',
    targetQuarterPkr: 50000000, // 5 Crore
    achievedQuarterPkr: 38000000 // 3.8 Crore
  });

  // Leads
  const [leads, setLeads] = useState<DealerLead[]>([
    { id: 'ld-1', name: 'Dr. Shahzad Hasan', phone: '+92 300 1122334', budgetPkr: 25000000, interestedCategory: 'Luxury Villa', precinct: 'Precinct 10-A', status: 'Hot', createdDate: '2026-02-20', notes: 'Looking for ready possession villa for family relocation' },
    { id: 'ld-2', name: 'Naveed Mughal (Overseas - UK)', phone: '+44 7911 123456', budgetPkr: 15000000, interestedCategory: 'Residential Plot', precinct: 'Precinct 15-B', status: 'Site Visit Booked', createdDate: '2026-02-22', notes: 'Brother will visit the plot on Saturday 11am' },
    { id: 'ld-3', name: 'Haji Abdul Qayyum', phone: '+92 321 8899001', budgetPkr: 40000000, interestedCategory: 'Commercial Shop', precinct: 'Midway Commercial B', status: 'Follow-up', createdDate: '2026-02-18', notes: 'Inquired about rental yield on ground floor shop' },
    { id: 'ld-4', name: 'Sarmad Iqbal', phone: '+92 333 4567890', budgetPkr: 8500000, interestedCategory: 'Apartment', precinct: 'Bahria Heights 2', status: 'New', createdDate: '2026-02-25', notes: 'First-time buyer, requires 2-bed installment plan' }
  ]);

  // Deals
  const [deals, setDeals] = useState<DealerDeal[]>([
    { id: 'dd-1', dealCode: 'DEAL-BTK-9901', propertyTitle: '200 Sq. Yards Villa #44', clientName: 'Kamran Akhtar', salePricePkr: 24500000, dealerCommissionPkr: 294000, platformSharePkr: 196000, status: 'Under Transfer', closeDate: '2026-02-14' },
    { id: 'dd-2', dealCode: 'DEAL-BTK-8419', propertyTitle: '125 Sq. Yards Plot #112', clientName: 'Mrs. Farzana Begum', salePricePkr: 7200000, dealerCommissionPkr: 86400, platformSharePkr: 57600, status: 'Disbursed', closeDate: '2026-01-28' },
    { id: 'dd-3', dealCode: 'DEAL-BTK-7104', propertyTitle: 'Midway Commercial Office #304', clientName: 'Apex Logistics Ltd', salePricePkr: 18000000, dealerCommissionPkr: 216000, platformSharePkr: 144000, status: 'Approved', closeDate: '2026-02-02' }
  ]);

  // Commission Ledger
  const [ledger, setLedger] = useState<CommissionLedgerEntry[]>([
    { id: 'led-1', date: '2026-02-14', type: 'Credit', description: '60% Commission - DEAL-BTK-9901 (Villa 44)', dealCode: 'DEAL-BTK-9901', amountPkr: 294000, balanceAfterPkr: 596400 },
    { id: 'led-2', date: '2026-02-05', type: 'Payout', description: 'IBFT Payout to Meezan Bank A/C ...2901', amountPkr: 250000, balanceAfterPkr: 302400 },
    { id: 'led-3', date: '2026-02-02', type: 'Credit', description: '60% Commission - DEAL-BTK-7104 (Midway)', dealCode: 'DEAL-BTK-7104', amountPkr: 216000, balanceAfterPkr: 552400 },
    { id: 'led-4', date: '2026-01-28', type: 'Credit', description: '60% Commission - DEAL-BTK-8419 (Plot 112)', dealCode: 'DEAL-BTK-8419', amountPkr: 86400, balanceAfterPkr: 336400 }
  ]);

  // Site visits assigned
  const [visits] = useState<SiteVisitRecord[]>([
    { id: 'v-1', propertyTitle: 'Precinct 15-B Plot 214', precinct: 'Precinct 15-B', date: '2026-03-01', timeSlot: '11:00 AM', agentName: 'Tariq Mahmood', agentPhone: '+92 300 8472910', status: 'Scheduled' },
    { id: 'v-2', propertyTitle: 'Midway Commercial Office', precinct: 'Midway B', date: '2026-03-02', timeSlot: '04:00 PM', agentName: 'Tariq Mahmood', agentPhone: '+92 300 8472910', status: 'Scheduled' }
  ]);

  // Tasks
  const [tasks, setTasks] = useState([
    { id: 'tsk-1', title: 'Submit Allotment verification files at Bahria Transfer Office', due: 'Today, 2:00 PM', priority: 'High', done: false },
    { id: 'tsk-2', title: 'Collect Pay Order for Token on Villa 44 from client', due: 'Tomorrow, 11:00 AM', priority: 'Urgent', done: false },
    { id: 'tsk-3', title: 'Share video walk-through with Overseas client Naveed', due: 'Friday, 5:00 PM', priority: 'Medium', done: true }
  ]);

  const [newLeadModalOpen, setNewLeadModalOpen] = useState(false);
  const [leadFormName, setLeadFormName] = useState('');
  const [leadFormPhone, setLeadFormPhone] = useState('');
  const [leadFormBudget, setLeadFormBudget] = useState('15000000');
  const [leadFormCategory, setLeadFormCategory] = useState('Luxury Villa');

  const availableBalance = ledger.length > 0 ? ledger[0].balanceAfterPkr : 0;

  const handleLogin = (e: React.FormEvent) => {
    e.preventDefault();
    setIsLoggedIn(true);
    localStorage.setItem('realtorx_dealer_logged_in', 'true');
  };

  const handleLogout = () => {
    setIsLoggedIn(false);
    localStorage.removeItem('realtorx_dealer_logged_in');
  };

  const handleAddLead = (e: React.FormEvent) => {
    e.preventDefault();
    if (!leadFormName || !leadFormPhone) return;

    const newLead: DealerLead = {
      id: `ld-${Date.now()}`,
      name: leadFormName,
      phone: leadFormPhone,
      budgetPkr: Number(leadFormBudget) || 10000000,
      interestedCategory: leadFormCategory,
      precinct: 'Bahria Town Karachi',
      status: 'New',
      createdDate: new Date().toISOString().split('T')[0],
      notes: 'Added via Dealer Portal'
    };

    setLeads([newLead, ...leads]);
    setNewLeadModalOpen(false);
    setLeadFormName('');
    setLeadFormPhone('');
  };

  // Check if oath is accepted when rendered
  useEffect(() => {
    const oathStatus = localStorage.getItem('realtorx_dealer_oath_accepted') === 'true';
    setHasAcceptedOath(oathStatus);
  }, []);

